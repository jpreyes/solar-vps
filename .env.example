POSTGRES_PASSWORD=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
SOLAR_USERNAME=
SOLAR_PASSWORD=
SOLAR_DEVICE_SN=
HISTORY_START_DATE=2026-10-18
HISTORY_SYNC_SECONDS=300
DEVICE_TIMEZONE=America/Santiago
WEATHER_LATITUDE=-39.81422
WEATHER_LONGITUDE=-73.24589
# Plano de cada string (azimut de brújula: 0 = norte, 90 = este, 180 = sur, 270 = oeste)
PV1_TILT=25
PV1_AZIMUTH=90
PV1_KWP=4.96
PV2_TILT=40
PV2_AZIMUTH=90
PV2_KWP=4.96
PV_KWP=9.92
PV_AC_LIMIT_KW=8
PV_PERFORMANCE_RATIO=0.80
# Etiqueta del inversor VM II Premium+ 12K: Voc máx. 500 V, MPPT 90–450 V, 27 A y 7500 W por entrada
INVERTER_MAX_PV_V=500
PV_PANEL_VOC=51.3
PV_PANELS_PER_STRING=8
# Batería y economía (placa NM51.2-300ES01: 51,2 V x 300 Ah)
BATTERY_KWH=15.36
BATTERY_MIN_SOC=20
GRID_TARIFF_CLP_KWH=230
BATTERY_WEAR_CLP_KWH=45
LOAD_WINTER_EXTRA=0.25
# Envejecimiento aproximado de la batería (temperatura del lugar donde está instalada)
BATTERY_TEMP_C=20
BATTERY_CALENDAR_PCT_YEAR=1.5
BATTERY_CYCLES_TO_80=6000
CLIMATE_YEARS=10
WEATHER_SYNC_SECONDS=1800
BACKUP_KEEP_DAYS=14
# Poner 1 solo si el panel está detrás de un proxy inverso HTTPS
TRUST_PROXY=0
# Control automático de umbrales (off = apagado, dry-run = solo simula y registra, on = envía al inversor)
CONTROL_MODE=off
CONTROL_BASE=20/30
CONTROL_WINTER=40/50
CONTROL_WINTER_MONTHS=6,7
CONTROL_STORM=1
CONTROL_STORM_GUST_KMH=60
# 0 = la lluvia no activa la reserva (en Valdivia no corta la luz)
CONTROL_STORM_RAIN_MM=0
# Apagada hasta probar con supervisión cuánta corriente toma realmente de la red (ver ANALISIS-BATERIA.md)
CONTROL_CALIBRATION=0
CONTROL_CALIBRATION_DAYS=10
# Corrientes (A, lado batería). En carga desde la red, MCC y MCG bajan a CONTROL_GRID_CHARGE_A (tope fijo
# CONTROL_GRID_CHARGE_CAP_A: 30 A ~ 8 A de red; con automático de 40 A y casa de 32 A el peor caso queda en 40 A).
CONTROL_GRID_CHARGE_A=30
CONTROL_GRID_CHARGE_CAP_A=30
CONTROL_GRID_CHARGE_IDLE_A=2
CONTROL_GRID_IMPORT_MAX_W=7000
# Vacío = mantener el valor del instalador; 150 = recomendado por la batería (etiqueta)
CONTROL_MAX_CHARGE_A=
# Cargador normal: 1 solar primero, 2 solar + red, 3 solo solar
CONTROL_CHARGER=3
CONTROL_MIN_SOC=15
CONTROL_MAX_COMMANDS_DAY=12
# No enviar si el inversor no reporta datos hace más de estos minutos
CONTROL_MAX_DATA_AGE_MIN=30
